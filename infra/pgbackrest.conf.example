# pgBackRest stanza config for the Puspa VPS (E-09, plan section 5.4).
# Generated by puspa.backup.wal.pgbackrest_config -- edit the values,
# never the structure, and keep this file out of the repo when it holds
# real credentials (the S3 key lives in the host secret store, and the
# repo1-cipher-pass is set with: pgbackrest --stanza=puspa stanza-create).
# Place at /etc/pgbackrest/pgbackrest.conf (mode 0600, owner postgres).
# Archive command (postgresql.conf):
#   archive_command = 'pgbackrest --stanza=puspa archive-push %p'
#   archive_mode = on
#   wal_level = replica
#
[global]
repo1-cipher-type=aes-256-cbc
repo1-retention-full=2
repo1-retention-diff=7
log-level-console=info
log-level-file=detail

[puspa]
pg1-path=/var/lib/postgresql/16/main
pg1-port=5432
pg1-user=postgres
repo1-type=s3
repo1-s3-bucket=puspa-backups
repo1-s3-endpoint=https://s3.example.invalid
repo1-s3-region=sgp1
repo1-s3-key-type=auto

