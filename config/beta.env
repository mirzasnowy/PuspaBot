# Beta profile (E-21, plan section 9.6) — the limited beta's defaults.
#
# Source this file (or pass it to the container with --env-file) to
# run a beta build: the frozen surfaces — marketplace, discovery,
# workflow, teams, and payment execution — are all OFF, and
# skills.sh installs stay off (E-12, plan 6.7). The same values live
# in code as `puspa.feature_flags.BETA_DEFAULTS`, applied when
# PUSPA_PROFILE=beta; this file spells them out explicitly so the
# deployed profile is auditable without reading code, and so an
# operator can see exactly what turning one back on means.
#
# Turning a surface back on is an explicit operator act: change
# that one line to 1. Never edit code to re-enable a beta surface.
# A flag is on only when its value is 1 / true / yes / on; anything
# else (including an empty value) counts as off.

PUSPA_PROFILE=beta
PUSPA_FLAG_MARKETPLACE=0
PUSPA_FLAG_DISCOVERY=0
PUSPA_FLAG_WORKFLOW=0
PUSPA_FLAG_TEAMS=0
PUSPA_FLAG_PAYMENT_EXECUTION=0
PUSPA_SKILL_INSTALL_ENABLED=0
